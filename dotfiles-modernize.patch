diff --git a/nvim/.config/nvim/lua/plugins/treesitter.lua b/nvim/.config/nvim/lua/plugins/treesitter.lua
new file mode 100644
index 0000000..82d47f1
--- /dev/null
+++ b/nvim/.config/nvim/lua/plugins/treesitter.lua
@@ -0,0 +1,62 @@
+-- nvim-treesitter `main` branch (the rewrite for Neovim 0.12). It only installs
+-- parsers and queries; highlighting/indent are switched on per buffer below.
+-- Requires the `tree-sitter` CLI and a C compiler (see Brewfile).
+local parsers = {
+	"c",
+	"css",
+	"go",
+	"html",
+	"javascript",
+	"json",
+	"lua",
+	"markdown",
+	"scss",
+	"typescript",
+	"vim",
+	"vimdoc",
+}
+
+return {
+	{
+		"nvim-treesitter/nvim-treesitter",
+		branch = "main",
+		lazy = false,
+		build = ":TSUpdate",
+		config = function()
+			require("nvim-treesitter").install(parsers)
+
+			vim.api.nvim_create_autocmd("FileType", {
+				group = vim.api.nvim_create_augroup("user-treesitter", { clear = true }),
+				callback = function(args)
+					-- Fails quietly for filetypes without a parser
+					if pcall(vim.treesitter.start, args.buf) then
+						vim.bo[args.buf].indentexpr = "v:lua.require'nvim-treesitter'.indentexpr()"
+					end
+				end,
+			})
+		end,
+	},
+	{
+		-- Provides the @function/@parameter queries used by mini.ai (see mini.lua)
+		-- and the function jumps below.
+		"nvim-treesitter/nvim-treesitter-textobjects",
+		branch = "main",
+		lazy = false,
+		config = function()
+			require("nvim-treesitter-textobjects").setup({ move = { set_jumps = true } })
+
+			local move = require("nvim-treesitter-textobjects.move")
+			local jumps = {
+				["]f"] = { move.goto_next_start, "Next function start" },
+				["[f"] = { move.goto_previous_start, "Previous function start" },
+				["]F"] = { move.goto_next_end, "Next function end" },
+				["[F"] = { move.goto_previous_end, "Previous function end" },
+			}
+			for lhs, m in pairs(jumps) do
+				vim.keymap.set({ "n", "x", "o" }, lhs, function()
+					m[1]("@function.outer", "textobjects")
+				end, { desc = m[2] })
+			end
+		end,
+	},
+}
diff --git a/tmux/.config/tmux/tmux.conf b/tmux/.config/tmux/tmux.conf
new file mode 100644
index 0000000..293602e
--- /dev/null
+++ b/tmux/.config/tmux/tmux.conf
@@ -0,0 +1,70 @@
+# tmux >= 3.1 reads this from ~/.config/tmux/tmux.conf.
+# tmux-sensible (below) already sets escape-time 0, focus-events, etc.
+
+# Prefix: uncomment to use C-a instead of C-b
+# set -g prefix C-a
+# unbind C-b
+# bind C-a send-prefix
+
+# Colours and extended keys (needed for Neovim) in Alacritty
+set -g default-terminal "tmux-256color"
+set -as terminal-features ",alacritty*:RGB:extkeys"
+set -s extended-keys on
+
+set -g mouse on
+set -g history-limit 100000
+
+# Number windows and panes from 1; ß (German layout) renumbers windows
+set -g base-index 1
+set -g pane-base-index 1
+bind ß move-window -r
+
+# Terminal title without tmux noise
+set -g set-titles on
+set -g set-titles-string "#{pane_title}"
+
+# New windows/splits open in the current directory; split with | and -
+bind c new-window -c "#{pane_current_path}"
+bind | split-window -h -c "#{pane_current_path}"
+bind - split-window -v -c "#{pane_current_path}"
+unbind '"'
+unbind %
+
+bind r source-file ~/.config/tmux/tmux.conf \; display "tmux.conf reloaded"
+
+# Alt-arrow switches panes without the prefix
+bind -n M-Left select-pane -L
+bind -n M-Right select-pane -R
+bind -n M-Up select-pane -U
+bind -n M-Down select-pane -D
+
+set -g window-status-separator ""
+
+# Plugins (TPM lives in ~/.config/tmux/plugins/tpm)
+set -g @plugin 'tmux-plugins/tpm'
+set -g @plugin 'tmux-plugins/tmux-sensible'
+set -g @plugin 'o0th/tmux-nova'
+
+# Nord palette throughout
+set -g @nova-nerdfonts true
+set -g @nova-nerdfonts-left 
+set -g @nova-nerdfonts-right 
+set -g @nova-pane-border-style "#3b4252"
+set -g @nova-pane-active-border-style "#88c0d0"
+set -g @nova-status-style-bg "#4c566a"
+set -g @nova-status-style-fg "#d8dee9"
+set -g @nova-status-style-active-bg "#89c0d0"
+set -g @nova-status-style-active-fg "#2e3540"
+set -g @nova-status-style-double-bg "#2d3540"
+
+set -g @nova-pane "#I#{?pane_in_mode,  #{pane_mode},}  #W"
+set -g @nova-segment-mode "#{?client_prefix,Ω,ω}"
+set -g @nova-segment-mode-colors "#78a2c1 #2e3440"
+set -g @nova-segment-whoami "#(whoami)@#h"
+set -g @nova-segment-whoami-colors "#78a2c1 #2e3440"
+set -g @nova-rows 0
+set -g @nova-segments-0-left "mode"
+set -g @nova-segments-0-right "whoami"
+
+# Keep at the very bottom
+run '~/.config/tmux/plugins/tpm/tpm'

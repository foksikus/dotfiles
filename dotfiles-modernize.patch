+# Everything these dotfiles expect. Install with: brew bundle
+brew "stow"
+brew "git"
+brew "neovim"          # >= 0.12
+brew "tmux"            # >= 3.1 (XDG config path)
+brew "fzf"             # fzf-lua
+brew "ripgrep"         # fzf-lua live grep
+brew "fd"              # fzf-lua file finder
+brew "tree-sitter-cli" # nvim-treesitter builds parsers with it
+brew "node"            # Copilot, prettier, ts_ls
+
+cask "alacritty"
+cask "karabiner-elements"
+cask "font-monofur-nerd-font"
